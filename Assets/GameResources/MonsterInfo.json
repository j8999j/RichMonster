    },
    {
      "InformationID": "Info_2_PiXiu",
      "MonsterID": "PiXiu",
      "MonsterInformationName": "祥瑞共鳴",
      "MonsterInformation": "自身就是吉祥的象徵，對帶有幸運氣息的物品有著同類相吸的特殊共鳴。",
      "TagID": "Lucky"
    },
    {
      "InformationID": "Info_3_PiXiu",
      "MonsterID": "PiXiu",
